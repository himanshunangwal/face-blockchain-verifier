# SerpApi Key for Google Lens reverse search
SERPAPI_API_KEY=your_serpapi_api_key

# Base Sepolia Testnet RPC URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployed VerificationRegistry Smart Contract Address on Base Sepolia
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Wallet Private Key for signing Base Sepolia transactions (Testnet only, with Sepolia ETH)
PRIVATE_KEY=your_wallet_private_key
